# Normalise to LF in the repository regardless of contributor platform.
# Without this, a Windows checkout commits CRLF and every Linux/macOS contributor sees
# whole-file diffs. CI runs on Linux, so LF in the repo is the correct canonical form.
* text=auto eol=lf

# Generated, but committed deliberately — mark it so it does not dominate diff review
# or inflate language statistics.
data/wcag.json linguist-generated=true

# Never munge line endings in binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ico binary

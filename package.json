{
  "name": "ai-accessibility-engineer",
  "version": "0.1.0-dev",
  "description": "WCAG scanner that pairs axe-core with an LLM judgment pass for the accessibility criteria automation can't reach.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacinthpaul/AI-Accessibility-Engineer.git"
  },
  "homepage": "https://github.com/jacinthpaul/AI-Accessibility-Engineer#readme",
  "bugs": {
    "url": "https://github.com/jacinthpaul/AI-Accessibility-Engineer/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "axe-core",
    "playwright",
    "sarif",
    "eaa"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "a11y-engineer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "prepublishOnly": "npm run build",
    "build:wcag": "tsx scripts/build-wcag-data.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "commander": "^14.0.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
